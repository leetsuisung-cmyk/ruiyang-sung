# ====== 資料庫（SQLite）======
# 本機開發：預設值即可
# 部署到 Zeabur 等有「持久化 Volume」的平台：把 Volume 掛載到某個路徑（例如 /data），
# 並把這裡改成指向該路徑，例如 "file:/data/prod.db"，容器重啟/重新部署後資料才不會遺失
# 注意：本專案固定使用 SQLite。若 Zeabur 上綁定過 PostgreSQL 服務或殘留 postgres:// 的
# DATABASE_URL 變數，請解除綁定／刪除該變數；即使沒設，scripts/start.js 也會在
# production 啟動時自動 fallback 成 "file:/data/prod.db"（非 file: 開頭的值會被強制覆蓋）
DATABASE_URL="file:./dev.db"

# ====== 檔案儲存（護照、匯款收據）======
# 本機開發：留空即可，檔案會存在專案的 uploads/ 資料夾
# 部署到 Zeabur：跟 DATABASE_URL 用同一個 Volume，設定例如 "/data/uploads"
# UPLOADS_DIR=""

# ====== 後台管理員帳號（單一帳號）======
# 開發環境：明碼密碼，seed script 會自動 bcrypt hash 後存入資料庫
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe123!"

# 簽署 session cookie 用的密鑰，正式環境務必更換為隨機長字串（例如 openssl rand -base64 32）
SESSION_SECRET="dev-only-secret-please-change-32chars-min"

# ====== 網站基本網址（產生 Email 內連結、付款回調網址用）======
APP_BASE_URL="http://localhost:3000"

# ====== 采威國際 HiTrust TrustPay ======
TRUSTPAY_STORE_ID="6J153"
# 官方 checktoken 產生演算法待取得 HiTrust API 文件後填入，目前為測試用途 placeholder
TRUSTPAY_SECRET_PLACEHOLDER="dev-only-placeholder-secret"
# 測試模式：不會真的呼叫 TrustPay，直接模擬付款成功，方便本機端到端測試
PAYMENT_TEST_MODE="true"

# ====== Email / SMTP ======
# 未設定 SMTP_HOST 時，系統會使用開發模式（console 印出信件內容，或用 EMAIL_DEV_MODE=ethereal 產生線上預覽連結）
EMAIL_DEV_MODE="console"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="睿煬旅行社 <no-reply@example.com>"

# 每筆新報名都會額外通知一份到這個信箱（公司內部信箱）
NOTIFY_EMAIL="notify@example.com"
